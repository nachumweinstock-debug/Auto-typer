{
  "manifest_version": 3,
  "name": "CableNOI Leads",
  "version": "1.0",
  "description": "LinkedIn Auto-Scraper for multifamily real estate leads",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "downloads"],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/search/results/people/*"],
      "js": ["content.js"]
    }
  ]
}
